# ============================================================================
# DISCORD CONFIGURATION
# ============================================================================
# Bot ID: https://discord.com/developers/applications
DISCORD_BOT_ID=

# Bot token: https://discord.com/developers/applications
DISCORD_BOT_TOKEN=

# Server ID: Enable Developer Mode, Right-click server, Copy ID
DISCORD_SERVER_ID=

# ============================================================================
# AI PROVIDERS
# ============================================================================
# Each AI-powered feature has its own fully self-contained provider config.
# Provider must be one of: gemini, deepseek, groq
# Each feature needs: PROVIDER, PROVIDER_API_KEY, PROVIDER_MODEL
# To disable the fallback, set FALLBACK_PROVIDER to an empty value.
#
# Sign-up links:
#   Gemini:  https://aistudio.google.com/app/apikey
#   DeepSeek: https://platform.deepseek.com/
#   Groq:    https://console.groq.com/keys

# --- Transliterate (primary) ---
TRANSLITERATE_PROVIDER=gemini
TRANSLITERATE_PROVIDER_API_KEY=
TRANSLITERATE_PROVIDER_MODEL=models/gemini-3-flash-preview

# --- Transliterate (fallback) ---
TRANSLITERATE_FALLBACK_PROVIDER=deepseek
TRANSLITERATE_FALLBACK_PROVIDER_API_KEY=
TRANSLITERATE_FALLBACK_PROVIDER_MODEL=deepseek-v4-flash

# --- Translate (primary) ---
TRANSLATE_PROVIDER=deepseek
TRANSLATE_PROVIDER_API_KEY=
TRANSLATE_PROVIDER_MODEL=deepseek-v4-flash

# --- Translate (fallback) ---
TRANSLATE_FALLBACK_PROVIDER=gemini
TRANSLATE_FALLBACK_PROVIDER_API_KEY=
TRANSLATE_FALLBACK_PROVIDER_MODEL=models/gemini-3-flash-preview

# --- Summarize (primary) ---
SUMMARIZE_PROVIDER=deepseek
SUMMARIZE_PROVIDER_API_KEY=
SUMMARIZE_PROVIDER_MODEL=deepseek-v4-flash

# --- Summarize (fallback) ---
SUMMARIZE_FALLBACK_PROVIDER=deepseek
SUMMARIZE_FALLBACK_PROVIDER_API_KEY=
SUMMARIZE_FALLBACK_PROVIDER_MODEL=deepseek-v4-flash

# ============================================================================
# EXTERNAL API KEYS
# ============================================================================
# Weather data - https://www.weatherapi.com/signup.aspx
WEATHERAPI_API_KEY=

# Local time - https://api.ipgeolocation.io/timezone
LOCALTIME_API_KEY=

# Currency exchange rates - https://app.currencyapi.com/register
CURRENCYAPI_API_KEY=

# Acqin services - https://acqin.org/api-access
ACQIN_API_KEY=

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# Database connection URL (default: SQLite)
DATABASE_URL=sqlite:///cocobot.db
DB_POOL_SIZE=5
DB_ECHO=false
INIT_DB_ON_STARTUP=true

# ============================================================================
# CACHE CONFIGURATION (Optional)
# ============================================================================
# CACHE_ENABLED=true
# REDIS_URL=
# CACHE_TTL=3600

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL=INFO
LOG_FILE=logs/cocobot.log
LOG_MAX_BYTES=1485760
LOG_BACKUP_COUNT=3

# ============================================================================
# SECURITY & PERFORMANCE
# ============================================================================
MAX_CONTENT_LENGTH=10000
ALLOWED_MENTIONS=true
ENABLE_CORS=false

# ============================================================================
# ENVIRONMENT
# ============================================================================
ENVIRONMENT=production
DEBUG=false

# ============================================================================
# MODERATION & JAIL CONFIGURATION
# ============================================================================
# Discord role ID for the "Warned" role
WARNED_ROLE_ID=1509612090489442396

# Discord role ID for "Jailed" role
JAIL_ROLE_ID=1475877270898872501

# Host and port for August Engelhardt's internal HTTP API
# Use 127.0.0.1 for local development
# Use host.docker.internal for Docker (requires extra_hosts in docker-compose.yml for Linux)
AUGUST_INTERNAL_HOST=127.0.0.1

# August Engelhardt internal API (for jail integration)
AUGUST_INTERNAL_PORT=17432
AUGUST_INTERNAL_SECRET=

