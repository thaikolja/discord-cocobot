# ============================================================================
# COCOBOT — Environment configuration
# ============================================================================
# Layout:
#   1. Discord       — bot identity and target server
#   2. AI            — shared provider keys (UseAI) + summarize provider
#   3. External APIs — weather, time, currency, air quality
#   4. Database      — SQLite (default) or PostgreSQL
#   5. Cache         — in-memory (default) or Redis
#   6. Logging
#   7. Security
#   8. Moderation    — warned role
#   9. Environment
# ----------------------------------------------------------------------------

# 1. Discord ----------------------------------------------------------------
# https://discord.com/developers/applications
DISCORD_BOT_ID=
DISCORD_BOT_TOKEN=
DISCORD_SERVER_ID=

# 2. AI ---------------------------------------------------------------------
# Providers: gemini | deepseek | groq
# Translate and transliterate always use Gemini (GEMINI_API_KEY / GEMINI_MODEL).
# Summarize uses SUMMARY_PROVIDER, then that provider's shared key/model.
# Gemini:   https://aistudio.google.com/app/apikey
# DeepSeek: https://platform.deepseek.com/
# Groq:     https://console.groq.com/keys

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

GROQ_API_KEY=
GROQ_MODEL=groq/compound

SUMMARY_PROVIDER=gemini
SUMMARY_MODEL=gemini-3.5-flash

# 3. External APIs ----------------------------------------------------------
# Weather:   https://www.weatherapi.com/signup.aspx
WEATHERAPI_API_KEY=
# Local time: https://api.ipgeolocation.io/timezone
LOCALTIME_API_KEY=
# Currency:  https://app.currencyapi.com/register
CURRENCYAPI_API_KEY=
# Air quality (WAQI): https://aqicn.org/api-access
ACQIN_API_KEY=

# 4. Database ---------------------------------------------------------------
DATABASE_URL=sqlite:///cocobot.db
DB_POOL_SIZE=5
DB_ECHO=false
INIT_DB_ON_STARTUP=true

# 5. Cache (in-memory by default; set CACHE_ENABLED=true to use Redis) ------
CACHE_ENABLED=false
REDIS_URL=
CACHE_TTL=3600

# 6. Logging ----------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=logs/cocobot.log
LOG_MAX_BYTES=1485760
LOG_BACKUP_COUNT=3

# 7. Security ---------------------------------------------------------------
MAX_CONTENT_LENGTH=10000
ALLOWED_MENTIONS=true
ENABLE_CORS=false

# 8. Moderation -------------------------------------------------------------
# Discord role assigned while a member has active warnings
WARNED_ROLE_ID=

# 9. Environment ------------------------------------------------------------
ENVIRONMENT=production
DEBUG=false
